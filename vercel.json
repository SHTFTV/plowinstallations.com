{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/guides/plow-mount-types-between-brands",
      "destination": "/guides/plow-mount-types-between-brands/index.html"
    },
    {
      "source": "/guides/plow-mount-types-between-brands/",
      "destination": "/guides/plow-mount-types-between-brands/index.html"
    },
    {
      "source": "/guides/how-long-does-plow-installation-take",
      "destination": "/guides/how-long-does-plow-installation-take/index.html"
    },
    {
      "source": "/guides/how-long-does-plow-installation-take/",
      "destination": "/guides/how-long-does-plow-installation-take/index.html"
    },
    {
      "source": "/guides/will-snow-plow-void-truck-warranty",
      "destination": "/guides/will-snow-plow-void-truck-warranty/index.html"
    },
    {
      "source": "/guides/will-snow-plow-void-truck-warranty/",
      "destination": "/guides/will-snow-plow-void-truck-warranty/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/publication-results.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
